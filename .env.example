# Copy to `.env` (already gitignored -- never commit `.env`) and fill in
# real values.

# --- Per-vendor API keys ---------------------------------------------------
# Each is a distinct secret -- these are never merged across vendors.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Required. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Shared tunables ---------------------------------------------------
# One number applies to every adapter it's relevant to, instead of a
# repeated per-vendor copy of the same value. Unset = the DEFAULT_* in
# collector/config.py applies.

# HTTP/SDK client timeout, in seconds. Applies to all four adapters
# (OpenAI, Gemini, Anthropic, SerpApi) -- every one of them builds a client
# that takes a timeout.
TIMEOUT_SECONDS=60

# SDK client retry count. Applies to OpenAI, Gemini, and Anthropic, whose
# clients all take a retry count. Does NOT apply to SerpApi -- the official
# `serpapi` client has no retry parameter to wire this to.
MAX_RETRIES=2

# Optional cap on response length. Applies to OpenAI and Gemini only, where
# it is a true optional cap -- leave blank for vendor default (no cap
# invented by the instrument). Does NOT apply to Anthropic, where
# `max_tokens` is a REQUIRED parameter on every request rather than an
# optional cap (see ANTHROPIC_MAX_TOKENS below). Does NOT apply to SerpApi,
# which has no token concept at all.
MAX_OUTPUT_TOKENS=

# --- Anthropic-only tunables -------------------------------------------
# No equivalent on any other engine, so these are not shared.

# Required by the Anthropic API on every request (unlike MAX_OUTPUT_TOKENS
# above, this cannot be left blank for a vendor default -- there isn't one).
ANTHROPIC_MAX_TOKENS=8192
# Optional cap on how many searches Claude may run per request. Leave blank
# (recommended): the consumer surface applies no such cap, and Anthropic's
# own guidance is that comparative/multi-entity questions -- this study's
# subject -- can legitimately need 10+ searches, so a low invented cap would
# silently truncate real answers rather than reflect what a buyer sees.
# Only set this if cost/latency control is a deliberate experiment decision.
ANTHROPIC_WEB_SEARCH_MAX_USES=
